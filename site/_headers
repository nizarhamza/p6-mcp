# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Cloudflare Web Analytics (on in the Pages project, Metrics): Cloudflare injects its beacon script from
# static.cloudflareinsights.com, which reports to cloudflareinsights.com; both are allowed below.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# One day for the other assets. Not a /assets/* rule: Cloudflare joins the headers of every matching rule,
# so the fonts would get both max-age values. The pages load site.css, site.js and theme.js with ?v=<content
# hash>, so a new version reaches visitors at once.
/assets/img/*
  Cache-Control: public, max-age=86400

/assets/site.css
  Cache-Control: public, max-age=86400

/assets/site.js
  Cache-Control: public, max-age=86400

/assets/theme.js
  Cache-Control: public, max-age=86400

/assets/search.json
  Cache-Control: public, max-age=86400

/assets/og.png
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
