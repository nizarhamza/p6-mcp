# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# One day for the other assets. Not a /assets/* rule: Cloudflare joins the headers of every matching rule,
# so the fonts would get both max-age values.
/assets/img/*
  Cache-Control: public, max-age=86400

/assets/vendor/*
  Cache-Control: public, max-age=86400

/assets/site.css
  Cache-Control: public, max-age=86400

/assets/site.js
  Cache-Control: public, max-age=86400

/assets/og.png
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
